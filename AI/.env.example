# Shared environment file for every service under AI/ (search-service, chatbot-service,
# recs-service, forecast-service). Copy this to `.env` in the same folder (AI/.env) and
# fill in real values — `AI/.env` is gitignored, never commit real secrets.
#
# Every service loads this same file (see shared_common/config.py and each service's
# app/core/config.py) so a key only needs to be set once here, not per-service.

# --- LLM API keys ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=


# --- Infra (defaults already match local docker-compose-infra.yml, override only if different) ---
REDIS_HOST=localhost
REDIS_PORT=6379
MONGO_URI=mongodb://localhost:27017/ecommerce_product_nosql
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_NAME=ecommerce_product_db

# --- chatbot-service specific (defaults already correct for local dev, override if needed) ---
# DEEPSEEK_MODEL_NAME=deepseek-chat
ORDER_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8085
PROMOTION_SERVICE_URL=http://localhost:8087
PRODUCT_SERVICE_URL=http://localhost:8089

# Copy sang .env (KHÔNG commit .env thật) rồi chỉnh theo môi trường của bạn.

# Kết nối MariaDB (infra-mariadb trong BE/docker-compose-infra.yml) — 1 server chứa cả 3 DB
# (ecommerce_user_db, ecommerce_product_db, ecommerce_order_db), phân biệt bằng tên DB.
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root

# Đổi nếu DB_NAME của service nào đó bị override khác default trong application.yml.
DB_USER_NAME=ecommerce_user_db
DB_PRODUCT_NAME=ecommerce_product_db
DB_ORDER_NAME=ecommerce_order_db

# Keycloak admin (chỉ cần khi --demo-users > 0) — mặc định admin/admin của master realm theo
# BE/docker-compose-infra.yml (KEYCLOAK_ADMIN/KEYCLOAK_ADMIN_PASSWORD).
KEYCLOAK_URL=http://localhost:8083
KEYCLOAK_REALM=ecommerce-realm
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Copy sang .env (KHÔNG commit .env thật) rồi chỉnh theo môi trường của bạn.

# Kaggle API (https://www.kaggle.com/settings -> API -> Create New Token, tải kaggle.json).
# Lấy đúng 2 giá trị "username" và "key" trong file đó, KHÔNG cần cài Kaggle CLI/Python.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Kết nối MariaDB — giống hệt tools/data-seed (1 server, nhiều DB, phân biệt bằng tên).
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_USER_NAME=ecommerce_user_db
DB_PRODUCT_NAME=ecommerce_product_db
DB_ORDER_NAME=ecommerce_order_db

# Olist gốc tính bằng BRL (Real Brazil). Nhân với tỉ giá này CHỈ để số hiển thị hợp lý dưới cột
# tiền tệ đang dùng VND trong DB — KHÔNG ảnh hưởng phân bố tương đối (recency/frequency/skew) mà
# model dùng để học, vì MinMaxScaler chuẩn hoá lại toàn bộ. Đặt =1 nếu muốn giữ nguyên số BRL gốc.
BRL_TO_VND_RATE=6000

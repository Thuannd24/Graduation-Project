{
  "permissions": {
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install -g:*)",
      "Bash(npm i -g:*)",
      "Bash(rm:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .agent/scripts/guard-bash.ps1"
          }
        ]
      }
    ]
  }
}

        <!-- Edge from Product ThreadPoolExecutor to PromptBuilder -->
        <mxCell id="e_pool_to_builder" value="Ngữ cảnh thông số kỹ thuật" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333ea;strokeWidth=2;fontColor=#6b21a8;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="thread_pool" target="prompt_builder">
          <mxGeometry relative="1" as="geometry">
            <Array points="225 740, 420 740" />
          </mxGeometry>
        </mxCell>

        <!-- Decision Branches from Gatekeeper eval_smax -->
        <!-- Branch 1: s_max >= 0.82 (OK) -->
        <mxCell id="e_gate_ok" value="s_max &gt;= 0.82 (OK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eval_smax" target="prompt_builder">
          <mxGeometry relative="1" as="geometry">
            <Array points="630 735, 520 735" />
          </mxGeometry>
        </mxCell>

        <!-- Branch 2: 0.80 <= s_max < 0.82 (Disclaimer) -->
        <mxCell id="e_gate_disc" value="0.80 &lt;= s_max &lt; 0.82 (Disclaimer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d97706;strokeWidth=2;fontColor=#b45309;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eval_smax" target="prompt_builder">
          <mxGeometry relative="1" as="geometry">
            <Array points="710 750, 600 750" />
          </mxGeometry>
        </mxCell>

        <!-- Branch 3: s_max < 0.80 (Reject ngắt LLM) -> Hard Stop -->
        <mxCell id="hard_stop_node" value="Hard Stop: Hotline 0389.468.847&#xa;&lt;font color='#991b1b' style='font-size: 10px;'&gt;Từ chối sinh ngôn ngữ - Ngắt gọi LLM&lt;/font&gt;" style="shape=component;align=center;verticalAlign=middle;rounded=1;arcSize=16;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#7f1d1d;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="770" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_gate_reject" value="s_max &lt; 0.80 (Reject ngắt LLM)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#b91c1c;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eval_smax" target="hard_stop_node">
          <mxGeometry relative="1" as="geometry">
            <Array points="810 740, 870 740" />
          </mxGeometry>
        </mxCell>

        <!-- Node: Mô hình DeepSeek-Chat Sinh Lời thoại -->
        <mxCell id="deepseek_model" value="Mô hình DeepSeek-Chat Sinh Lời thoại&#xa;&lt;font color='#831843' style='font-size: 10px; font-family: monospace;'&gt;POST https://api.deepseek.com/chat/completions&lt;/font&gt;" style="shape=component;align=center;verticalAlign=middle;rounded=1;arcSize=16;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#831843;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="875" width="350" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_builder_to_deepseek" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366f1;strokeWidth=2;" edge="1" parent="1" source="prompt_builder" target="deepseek_model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Node: Phản hồi cuối cùng cho Khách hàng -->
        <mxCell id="final_response" value="Phản hồi cuối cùng cho Khách hàng&#xa;&lt;font color='#0f766e' style='font-size: 10px;'&gt;JSON Payload {message, products, card} render AIChatbotWidget&lt;/font&gt;" style="shape=component;align=center;verticalAlign=middle;rounded=1;arcSize=16;fillColor=#ccfbf1;strokeColor=#0d9488;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#115e59;shadow=1;" vertex="1" parent="1">

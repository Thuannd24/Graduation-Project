        <!-- ========================================================================= -->
        <!-- 3. RIGHT BOTTOM CONTAINER: CỔNG KIỂM SOÁT ĐỘ TIN CẬY (GATEKEEPER) -->
        <!-- ========================================================================= -->
        <mxCell id="box_gatekeeper" value="Cổng Kiểm soát Độ tin cậy (Gatekeeper)" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#92400e;collapsible=0;dropTarget=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="605" width="460" height="105" as="geometry" />
        </mxCell>

        <!-- Node: Đánh giá s_max = max(s_i) -->
        <mxCell id="eval_smax" value="Đánh giá s_max = max(s_i)&#xa;&lt;font color='#b45309' style='font-size: 10px;'&gt;So khớp ngưỡng tin cậy &amp; Ngắt ảo giác Hallucination&lt;/font&gt;" style="shape=component;align=center;verticalAlign=middle;rounded=1;arcSize=16;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#78350f;shadow=1;" vertex="1" parent="box_gatekeeper">

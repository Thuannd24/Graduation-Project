        </mxCell>

        <!-- ========================================================================= -->
        <!-- 4. BOTTOM PIPELINE: SYNTHESIS, LLM & FINAL RESPONSE -->
        <!-- ========================================================================= -->

        <!-- Node: Bộ ghép nối Ngữ cảnh PromptBuilderService -->
        <mxCell id="prompt_builder" value="Bộ ghép nối Ngữ cảnh PromptBuilderService&#xa;&lt;font color='#4338ca' style='font-size: 10px;'&gt;System Prompt + User Info + Context RAG (Specs / Policy Chunks)&lt;/font&gt;" style="shape=component;align=center;verticalAlign=middle;rounded=1;arcSize=16;fillColor=#ede9fe;strokeColor=#6366f1;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#312e81;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="770" width="380" height="60" as="geometry" />

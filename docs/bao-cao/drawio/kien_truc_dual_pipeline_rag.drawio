        <!-- Node: Encoder: multilingual-e5-base Vector 768 chiều -->
        <mxCell id="encoder_e5" value="Encoder: multilingual-e5-base&#xa;&lt;font color='#047857' style='font-size: 10px;'&gt;Dense Vector 768 chiều (Unit L2 Norm)&lt;/font&gt;" style="shape=component;align=center;verticalAlign=middle;rounded=1;arcSize=16;fillColor=#d1fae5;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#064e3b;shadow=1;" vertex="1" parent="box_policy_rag">

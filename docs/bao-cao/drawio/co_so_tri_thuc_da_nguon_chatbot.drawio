<mxfile host="app.diagrams.net" agent="Antigravity AI">
  <diagram id="Multi_Source_Knowledge_Base" name="Cơ sở Tri thức Đa nguồn Aura">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="720" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Tiêu đề sơ đồ -->
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=15;fontColor=#0f172a;" value="KIẾN TRÚC TÍCH HỢP CƠ SỞ TRI THỨC ĐA NGUỒN CỦA TRỢ LÝ AI AURA" vertex="1">
          <mxGeometry height="30" width="620" x="240" y="15" as="geometry" />
        </mxCell>

        <!-- Đỉnh: Khách hàng / Người dùng -->
        <mxCell id="user_node" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#4c1d95;shadow=1;" value="Khách hàng / Người dùng" vertex="1">
          <mxGeometry height="54" width="220" x="440" y="65" as="geometry" />
        </mxCell>

        <!-- Trung tâm: Bộ máy Điều phối Hội thoại Aura -->
        <mxCell id="aura_engine" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1e1b4b;shadow=1;" value="Bộ máy Điều phối Hội thoại Aura&#xa;(Aura Task-Oriented Dialogue Engine)" vertex="1">
          <mxGeometry height="68" width="320" x="390" y="210" as="geometry" />
        </mxCell>

        <!-- Mũi tên: Người dùng -> Aura Engine -->
        <mxCell id="e_user_to_engine" edge="1" parent="1" source="user_node" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4338ca;strokeWidth=2;fontColor=#3730a3;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" target="aura_engine" value="Truy vấn ngôn ngữ tự nhiên (x)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="495" y="125" as="sourcePoint" />
            <mxPoint x="470" y="205" as="targetPoint" />
            <Array as="points">
              <mxPoint x="480" y="140" />
              <mxPoint x="480" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Mũi tên: Aura Engine -> Người dùng -->
        <mxCell id="e_engine_to_user" edge="1" parent="1" source="aura_engine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" target="user_node" value="Phản hồi tự nhiên kèm Card UI">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="205" as="sourcePoint" />
            <mxPoint x="605" y="125" as="targetPoint" />
            <Array as="points">
              <mxPoint x="620" y="210" />
              <mxPoint x="620" y="140" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Khung chứa: Cơ sở Tri thức Đa nguồn -->
        <mxCell id="kb_container" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffdf0;strokeColor=#d97706;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#92400e;collapsible=0;dropTarget=0;shadow=1;" value="Cơ sở Tri thức Đa nguồn" vertex="1">
          <mxGeometry height="185" width="1000" x="50" y="475" as="geometry" />
        </mxCell>

        <!-- Khối 1: Kho Tri thức Chính sách Phi cấu trúc -->
        <mxCell id="kb_policy" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#4c1d95;shadow=1;" value="Kho Tri thức Chính sách Phi cấu trúc:&#xa;Markdown Corpus&#xa;(Chỉ mục FAISS Vector DB)" vertex="1">
          <mxGeometry height="110" width="290" x="80" y="525" as="geometry" />
        </mxCell>

        <!-- Khối 2: CSDL Sản phẩm Động -->
        <mxCell id="kb_product" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#0369a1;shadow=1;" value="Cơ sở Dữ liệu Sản phẩm Động:&#xa;Product Service :8089&#xa;(Catalog &amp; Specs thời gian thực)" vertex="1">
          <mxGeometry height="110" width="290" x="405" y="525" as="geometry" />
        </mxCell>

        <!-- Khối 3: Dữ liệu Giao dịch Khách hàng -->
        <mxCell id="kb_trans" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#065f46;shadow=1;" value="Dữ liệu Giao dịch Khách hàng:&#xa;Order, User, Promotion Services&#xa;(API Nội bộ bảo mật qua Gateway)" vertex="1">
          <mxGeometry height="110" width="290" x="730" y="525" as="geometry" />
        </mxCell>

        <!-- Luồng 1a: Engine -> Policy (Truy xuất Ngữ nghĩa Dày đặc) -->
        <mxCell id="e_engine_to_policy" edge="1" parent="1" source="aura_engine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7c3aed;strokeWidth=2;fontColor=#6d28d9;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" target="kb_policy" value="Truy xuất Ngữ nghĩa Dày đặc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="340" />
              <mxPoint x="150" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Luồng 1b: Policy -> Engine (Đoạn tri thức chính sách chuẩn xác) -->
        <mxCell id="e_policy_to_engine" edge="1" parent="1" source="kb_policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7c3aed;strokeWidth=2;dashed=1;fontColor=#6d28d9;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" target="aura_engine" value="Đoạn tri thức chính sách chuẩn xác">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="295" y="390" />
              <mxPoint x="460" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Luồng 2a: Engine -> Product (Tìm kiếm Từ khóa & Thuộc tính) -->
        <mxCell id="e_engine_to_product" edge="1" parent="1" source="aura_engine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" target="kb_product" value="Tìm kiếm Từ khóa &amp; Thuộc tính">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="370" />
              <mxPoint x="500" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Luồng 2b: Product -> Engine (Thông số kỹ thuật & Giá thời gian thực) -->
        <mxCell id="e_product_to_engine" edge="1" parent="1" source="kb_product" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284c7;strokeWidth=2;dashed=1;fontColor=#0369a1;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" target="aura_engine" value="Thông số kỹ thuật &amp; Giá thời gian thực">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="470" />
              <mxPoint x="600" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Luồng 3a: Engine -> Transaction (Gọi Công cụ Xác định) -->
        <mxCell id="e_engine_to_trans" edge="1" parent="1" source="aura_engine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" target="kb_trans" value="Gọi Công cụ Xác định">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="390" />
              <mxPoint x="805" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Luồng 3b: Transaction -> Engine (Trạng thái đơn hàng, Voucher, Điểm thưởng) -->
        <mxCell id="e_trans_to_engine" edge="1" parent="1" source="kb_trans" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;dashed=1;fontColor=#065f46;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" target="aura_engine" value="Trạng thái đơn hàng, Voucher, Điểm thưởng">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="340" />
              <mxPoint x="680" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>


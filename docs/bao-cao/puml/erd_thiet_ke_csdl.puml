@startuml erd_thiet_ke_csdl
title Hình ảnh 6. Sơ đồ cơ sở dữ liệu quan hệ vật lý (Physical ERD) Hệ thống AuraTech

!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

skinparam {
  vpDiagramType ERD
  defaultFontName "Segoe UI", Arial, sans-serif
  defaultFontSize 9.5
  defaultFontColor #000000
  roundcorner 0
  shadowing false
  linetype ortho
  nodesep 22
  ranksep 22
}

skinparam entity {
  BackgroundColor #EBF8FE
  BorderColor #000000
  BorderThickness 1.2
  FontColor #000000
  FontStyle bold
  FontSize 9.5
}

skinparam arrow {
  Color #000000
  Thickness 1.2
  FontColor #000000
  FontSize 8.5
}

' ==============================================================
' 1. NHÓM TÁC NHÂN CON NGƯỜI & ĐỐI TÁC CUNG ỨNG
' ==============================================================
entity "Member" as Member {
  * id : bigint <<PK>>
  --
  username : varchar(100)
  password : varchar(255)
  fullName : varchar(150)
  email : varchar(150)
  phoneNumber : varchar(20)
  avatarUrl : varchar(500)
  active : boolean
  createdAt : datetime
  updatedAt : datetime
}

entity "Customer" as Customer {
  * Memberid : bigint <<PK, FK>>
  --
  keycloakUserId : varchar(100)
  customerTier : varchar(20)
  loyaltyPoints : integer(10)
  segmentationLabel : varchar(50)
  isBlacklisted : boolean
  active : boolean
}

entity "Employee" as Employee {
  * Memberid : bigint <<PK, FK>>
  --
  employeeCode : varchar(50)
  role : varchar(50)
  department : varchar(100)
  active : boolean
}

entity "Supplier" as Supplier {
  * id : bigint <<PK>>
  --
  supplierCode : varchar(50)
  companyName : varchar(200)
  taxCode : varchar(50)
  email : varchar(150)
  phoneNumber : varchar(20)
  address : varchar(255)
  active : boolean
  createdAt : datetime
}

' ==============================================================
' 2. NHÓM ĐỊA CHỈ HÀNH CHÍNH
' ==============================================================
entity "Province" as Province {
  * code : integer(10) <<PK>>
  --
  name : varchar(100)
}

entity "Ward" as Ward {
  * code : integer(10) <<PK>>
  --
  name : varchar(100)
  Provincecode : integer(10) <<FK>>
}

entity "Address" as Address {
  * id : bigint <<PK>>
  --
  recipientName : varchar(150)
  phoneNumber : varchar(20)
  province : varchar(100)
  districtWard : varchar(100)
  detailAddress : varchar(255)
  isDefault : boolean
  Customerid : bigint <<FK>>
  Provincecode : integer(10) <<FK>>
  Wardcode : integer(10) <<FK>>
}

' ==============================================================
' 3. NHÓM SẢN PHẨM, DANH MỤC & THUỘC TÍNH
' ==============================================================
entity "Category" as Category {
  * id : bigint <<PK>>
  --
  name : varchar(200)
  slug : varchar(200)
  parentId : bigint
  imageUrl : varchar(500)
  icon : varchar(100)
  sortOrder : integer(10)
  active : boolean
}

entity "Brand" as Brand {
  * id : bigint <<PK>>
  --
  name : varchar(150)
  slug : varchar(150)
  logoUrl : varchar(500)
  description : text
}

entity "Product" as Product {
  * id : bigint <<PK>>
  --
  name : varchar(255)
  slug : varchar(255)
  description : text
  attributes : text
  specsRaw : text
  price : decimal(15,2)
  costPrice : decimal(15,2)
  salePrice : decimal(15,2)
  weight : decimal(10,2)
  brand : varchar(100)
  imageUrl : varchar(500)
  warrantyPeriod : integer(10)
  warrantyPolicy : text
  salesCount : integer(10)
  ratingAvg : decimal(3,2)
  active : boolean
  Categoryid : bigint <<FK>>
  Brandid : bigint <<FK>>
}

entity "ProductVariant" as ProductVariant {
  * id : bigint <<PK>>
  --
  sku : varchar(100)
  variantAttr : text
  price : decimal(15,2)
  costPrice : decimal(15,2)
  salePrice : decimal(15,2)
  weight : decimal(10,2)
  imageUrl : varchar(500)
  active : boolean
  Productid : bigint <<FK>>
}

entity "ProductImage" as ProductImage {
  * id : bigint <<PK>>
  --
  imageUrl : varchar(500)
  sortOrder : integer(10)
  isPrimary : boolean
  Productid : bigint <<FK>>
}

entity "ProductTag" as ProductTag {
  * id : bigint <<PK>>
  --
  tag : varchar(100)
  Productid : bigint <<FK>>
}

entity "Attribute" as Attribute {
  * id : bigint <<PK>>
  --
  code : varchar(50)
  name : varchar(100)
  valueType : varchar(50)
  allowedValues : text
  isColor : boolean
}

entity "CategoryAttribute" as CategoryAttribute {
  * id : bigint <<PK>>
  --
  isVariant : boolean
  isRequired : boolean
  isFilter : boolean
  Categoryid : bigint <<FK>>
  Attributeid : bigint <<FK>>
}

entity "ProductAttributeValue" as ProductAttributeValue {
  * id : bigint <<PK>>
  --
  value : varchar(255)
  Productid : bigint <<FK>>
  Attributeid : bigint <<FK>>
}

entity "VariantOptionValue" as VariantOptionValue {
  * id : bigint <<PK>>
  --
  value : varchar(255)
  ProductVariantid : bigint <<FK>>
  Attributeid : bigint <<FK>>
}

entity "ProductReview" as ProductReview {
  * id : bigint <<PK>>
  --
  rating : integer(10)
  comment : text
  imageUrls : text
  staffReplyContent : text
  staffReplyAt : datetime
  staffReplierId : varchar(100)
  createdAt : datetime
  Customerid : bigint <<FK>>
  Productid : bigint <<FK>>
  Orderid : bigint <<FK>>
}

entity "WishlistItem" as WishlistItem {
  * id : bigint <<PK>>
  --
  createdAt : datetime
  Customerid : bigint <<FK>>
  Productid : bigint <<FK>>
}

' ==============================================================
' 4. NHÓM ĐƠN HÀNG, THANH TOÁN & ĐIỂM THƯỞNG
' ==============================================================
entity "Order" as Order {
  * id : bigint <<PK>>
  --
  userId : varchar(100)
  email : varchar(150)
  status : varchar(30)
  totalAmount : decimal(15,2)
  discountAmount : decimal(15,2)
  finalAmount : decimal(15,2)
  totalWeight : decimal(10,2)
  couponCode : varchar(50)
  appliedCampaignId : varchar(50)
  pointsRedeemed : integer(10)
  pointDiscountAmount : decimal(15,2)
  shippingFee : decimal(15,2)
  shippingDiscountAmount : decimal(15,2)
  vatAmount : decimal(15,2)
  trackingCode : varchar(100)
  shippingAddress : text
  phoneNumber : varchar(20)
  note : text
  createdAt : datetime
  updatedAt : datetime
  Customerid : bigint <<FK>>
}

entity "OrderItem" as OrderItem {
  * id : bigint <<PK>>
  --
  productName : varchar(255)
  productImage : varchar(500)
  variantAttr : text
  unitPrice : decimal(15,2)
  quantity : integer(10)
  subtotal : decimal(15,2)
  Orderid : bigint <<FK>>
  ProductVariantid : bigint <<FK>>
}

entity "Payment" as Payment {
  * id : bigint <<PK>>
  --
  txnRef : varchar(100)
  gatewayTxnId : varchar(100)
  paymentMethod : varchar(50)
  amount : decimal(15,2)
  currency : varchar(10)
  status : varchar(20)
  failureCode : varchar(50)
  gatewayResponse : text
  paidAt : datetime
  createdAt : datetime
  updatedAt : datetime
  Orderid : bigint <<FK>>
  Customerid : bigint <<FK>>
}

entity "Refund" as Refund {
  * id : bigint <<PK>>
  --
  refundAmount : decimal(15,2)
  reason : text
  status : varchar(20)
  gatewayRefundId : varchar(100)
  requestedBy : varchar(100)
  completedAt : datetime
  createdAt : datetime
  Paymentid : bigint <<FK>>
}

entity "WebhookLog" as WebhookLog {
  * id : bigint <<PK>>
  --
  gateway : varchar(50)
  rawPayload : text
  signatureValid : boolean
  processed : boolean
  createdAt : datetime
  Paymentid : bigint <<FK>>
}

entity "LoyaltyPointTransaction" as LoyaltyPointTransaction {
  * id : bigint <<PK>>
  --
  delta : integer(10)
  balanceAfter : integer(10)
  calculationMode : varchar(50)
  sourceType : varchar(50)
  referenceId : varchar(100)
  description : text
  createdAt : datetime
  Customerid : bigint <<FK>>
  Orderid : bigint <<FK>>
  Campaignid : bigint <<FK>>
}

' ==============================================================
' 5. NHÓM KHUYẾN MÃI & CHIẾN DỊCH
' ==============================================================
entity "Campaign" as Campaign {
  * id : bigint <<PK>>
  --
  name : varchar(255)
  totalBudget : decimal(15,2)
  remainingBudget : decimal(15,2)
  startDate : datetime
  endDate : datetime
  bpmnProcessDefinitionKey : varchar(100)
  workflowJson : text
  bpmnXml : text
  triggerType : varchar(50)
  createdAt : datetime
  updatedAt : datetime
}

entity "IssuedVoucher" as IssuedVoucher {
  * id : bigint <<PK>>
  --
  code : varchar(50)
  voucherType : varchar(30)
  discountPercent : decimal(5,2)
  maxDiscountAmount : decimal(15,2)
  discountAmount : decimal(15,2)
  minOrderValue : decimal(15,2)
  maxShippingDiscount : decimal(15,2)
  restrictedCategoryIds : text
  restrictedProductIds : text
  expiresAt : datetime
  usedAt : datetime
  idempotencyKey : varchar(100)
  createdAt : datetime
  Campaignid : bigint <<FK>>
  Customerid : bigint <<FK>>
  Orderid : bigint <<FK>>
}

entity "ExecutedAction" as ExecutedAction {
  * id : bigint <<PK>>
  --
  idempotencyKey : varchar(100)
  actionType : varchar(50)
  createdAt : datetime
  Campaignid : bigint <<FK>>
}

' ==============================================================
' 6. NHÓM KHO HÀNG & NHẬP XUẤT
' ==============================================================
entity "Inventory" as Inventory {
  * id : bigint <<PK>>
  --
  quantity : integer(10)
  updatedAt : datetime
  ProductVariantid : bigint <<FK>>
}

entity "InventoryTransaction" as InventoryTransaction {
  * id : bigint <<PK>>
  --
  transactionType : varchar(30)
  quantityChanged : integer(10)
  quantityBefore : integer(10)
  quantityAfter : integer(10)
  referenceId : varchar(100)
  note : text
  createdAt : datetime
  Inventoryid : bigint <<FK>>
  Orderid : bigint <<FK>>
}

entity "RestockRequest" as RestockRequest {
  * id : bigint <<PK>>
  --
  quantity : integer(10)
  status : varchar(30)
  requestedBy : varchar(100)
  completedAt : datetime
  createdAt : datetime
  Employeeid : bigint <<FK>>
  Supplierid : bigint <<FK>>
  ProductVariantid : bigint <<FK>>
}

entity "InventoryDailySnapshot" as InventoryDailySnapshot {
  * id : bigint <<PK>>
  --
  stockLevel : integer(10)
  snapshotDate : date
  createdAt : datetime
  ProductVariantid : bigint <<FK>>
}

' ==============================================================
' 7. NHÓM TƯ VẤN, THÔNG BÁO & SỰ KIỆN PHÂN TÁN
' ==============================================================
entity "ChatRoom" as ChatRoom {
  * id : bigint <<PK>>
  --
  customerName : varchar(150)
  staffName : varchar(150)
  status : varchar(30)
  lastMessage : text
  lastMessageAt : datetime
  lastMessageSenderId : varchar(100)
  createdAt : datetime
  updatedAt : datetime
  Customerid : bigint <<FK>>
  Employeeid : bigint <<FK>>
}

entity "ChatMessage" as ChatMessage {
  * id : bigint <<PK>>
  --
  senderId : varchar(100)
  senderName : varchar(150)
  senderRole : varchar(30)
  content : text
  type : varchar(30)
  isRead : boolean
  createdAt : datetime
  ChatRoomid : bigint <<FK>>
}

entity "Notification" as Notification {
  * id : varchar(50) <<PK>>
  --
  eventType : varchar(100)
  channels : varchar(100)
  recipient : varchar(200)
  subject : varchar(255)
  content : text
  status : varchar(30)
  deliveryResults : text
  createdAt : datetime
  Customerid : bigint <<FK>>
  NotificationTemplateid : varchar(50) <<FK>>
  Orderid : bigint <<FK>>
}

entity "NotificationTemplate" as NotificationTemplate {
  * id : varchar(50) <<PK>>
  --
  code : varchar(100)
  name : varchar(200)
  titleTemplate : text
  bodyTemplate : text
  channel : varchar(50)
}

entity "FCMToken" as FCMToken {
  * id : varchar(50) <<PK>>
  --
  token : text
  platform : varchar(30)
  deviceId : varchar(100)
  lastUsedAt : datetime
  Customerid : bigint <<FK>>
}

entity "OutboxEvent" as OutboxEvent {
  * id : bigint <<PK>>
  --
  aggregateId : varchar(100)
  aggregateType : varchar(50)
  eventType : varchar(100)
  payload : text
  status : varchar(20)
  retryCount : integer(10)
  createdAt : datetime
  processedAt : datetime
  Orderid : bigint <<FK>>
}

entity "CompensationTask" as CompensationTask {
  * id : bigint <<PK>>
  --
  taskType : varchar(50)
  status : varchar(30)
  attempts : integer(10)
  lastError : text
  createdAt : datetime
  updatedAt : datetime
  Orderid : bigint <<FK>>
}

entity "UserEvent" as UserEvent {
  * id : bigint <<PK>>
  --
  sessionId : varchar(100)
  actionType : varchar(50)
  weight : decimal(5,2)
  source : varchar(50)
  createdAt : datetime
  Customerid : bigint <<FK>>
  Productid : bigint <<FK>>
  Categoryid : bigint <<FK>>
}

' ==============================================================
' CÁC ĐƯỜNG LIÊN KẾT KHÓA NGOẠI (RELATIONSHIPS)
' ==============================================================
Member ||--|| Customer : "Memberid"
Member ||--|| Employee : "Memberid"

Customer ||--o{ Address : "Customerid"
Province ||--o{ Ward : "Provincecode"
Province ||--o{ Address : "Provincecode"
Ward ||--o{ Address : "Wardcode"

Category ||--o{ Product : "Categoryid"
Brand ||--o{ Product : "Brandid"
Category ||--o{ CategoryAttribute : "Categoryid"
Attribute ||--o{ CategoryAttribute : "Attributeid"

Product ||--o{ ProductVariant : "Productid"
Product ||--o{ ProductImage : "Productid"
Product ||--o{ ProductTag : "Productid"
Product ||--o{ ProductAttributeValue : "Productid"
Attribute ||--o{ ProductAttributeValue : "Attributeid"

ProductVariant ||--o{ VariantOptionValue : "ProductVariantid"
Attribute ||--o{ VariantOptionValue : "Attributeid"

Customer ||--o{ Order : "Customerid"
Order ||--o{ OrderItem : "Orderid"
ProductVariant ||--o{ OrderItem : "ProductVariantid"

Order ||--|| Payment : "Orderid"
Customer ||--o{ Payment : "Customerid"
Payment ||--o{ Refund : "Paymentid"
Payment ||--o{ WebhookLog : "Paymentid"

Customer ||--o{ ProductReview : "Customerid"
Product ||--o{ ProductReview : "Productid"
Order ||--o{ ProductReview : "Orderid"

Customer ||--o{ WishlistItem : "Customerid"
Product ||--o{ WishlistItem : "Productid"

Customer ||--o{ LoyaltyPointTransaction : "Customerid"
Order ||--o{ LoyaltyPointTransaction : "Orderid"
Campaign ||--o{ LoyaltyPointTransaction : "Campaignid"

Campaign ||--o{ IssuedVoucher : "Campaignid"
Customer ||--o{ IssuedVoucher : "Customerid"
Order ||--o{ IssuedVoucher : "Orderid"
Campaign ||--o{ ExecutedAction : "Campaignid"

ProductVariant ||--|| Inventory : "ProductVariantid"
Inventory ||--o{ InventoryTransaction : "Inventoryid"
Order ||--o{ InventoryTransaction : "Orderid"
ProductVariant ||--o{ InventoryDailySnapshot : "ProductVariantid"

Employee ||--o{ RestockRequest : "Employeeid"
Supplier ||--o{ RestockRequest : "Supplierid"
ProductVariant ||--o{ RestockRequest : "ProductVariantid"

Customer ||--o{ ChatRoom : "Customerid"
Employee ||--o{ ChatRoom : "Employeeid"
ChatRoom ||--o{ ChatMessage : "ChatRoomid"

NotificationTemplate ||--o{ Notification : "NotificationTemplateid"
Customer ||--o{ Notification : "Customerid"
Order ||--o{ Notification : "Orderid"
Customer ||--o{ FCMToken : "Customerid"

Customer ||--o{ UserEvent : "Customerid"
Product ||--o{ UserEvent : "Productid"
Category ||--o{ UserEvent : "Categoryid"

Order ||--o{ OutboxEvent : "Orderid"
Order ||--o{ CompensationTask : "Orderid"

right footer Powered By Visual Paradigm Community Edition

@enduml

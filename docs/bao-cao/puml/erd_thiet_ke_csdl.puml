@startuml erd_thiet_ke_csdl

<style>
document {
  BackgroundColor #FFFFFF
}
classDiagram {
  LineColor #000000
  LineThickness 1.2
  arrow {
    LineColor #000000
    LineThickness 1.2
    FontColor #000000
    FontSize 8
  }
  class {
    LineColor #000000
    LineThickness 1.2
    RoundCorner 10
    BackgroundColor #F5B67A
    FontColor #000000
    FontStyle bold
  }
  entity {
    LineColor #000000
    LineThickness 1.2
    RoundCorner 10
    BackgroundColor #F5B67A
    FontColor #000000
    FontStyle bold
  }
}
footer {
  FontColor #666666
  FontSize 8
}
</style>

skinparam {
  vpDiagramType ERD
  BackgroundColor #FFFFFF
  defaultFontSize 8
  defaultFontColor #000000
  roundcorner 10
  shadowing false
  linetype ortho
  classAttributeIconSize 0
  nodesep 34
  ranksep 26
}
hide circle

skinparam ClassBackgroundColor #F5B67A
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1.2
skinparam ClassFontColor #000000
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 8

skinparam EntityBackgroundColor #F5B67A
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1.2
skinparam EntityFontColor #000000
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 8

skinparam ArrowColor #000000
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 8

' ==============================================================
' CỘT 1: NGƯỜI DÙNG & ĐỊA CHỈ (USER & ADDRESS DOMAIN)
' ==============================================================
entity "Member" as Member {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> username : varchar(100)
  <color:#1D4E89><&spreadsheet></color> fullName : varchar(150)
  <color:#1D4E89><&spreadsheet></color> email : varchar(150)
  <color:#1D4E89><&spreadsheet></color> phoneNumber : varchar(20)
  <color:#1D4E89><&spreadsheet></color> avatarUrl : varchar(500)
  <color:#1D4E89><&spreadsheet></color> active : boolean
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#1D4E89><&spreadsheet></color> updatedAt : datetime
}

entity "Staff" as Staff {
  <color:#2E7D32><&key></color> <b><i>Memberid</i></b> : <b><i>bigint</i></b>
  --
  <color:#1D4E89><&spreadsheet></color> role : varchar(50)
  <color:#1D4E89><&spreadsheet></color> department : varchar(100)
}

entity "Customer" as Customer {
  <color:#2E7D32><&key></color> <b><i>Memberid</i></b> : <b><i>bigint</i></b>
  --
  <color:#1D4E89><&spreadsheet></color> keycloakUserId : varchar(100)
  <color:#1D4E89><&spreadsheet></color> customerTier : varchar(20)
  <color:#1D4E89><&spreadsheet></color> loyaltyPoints : integer(10)
  <color:#1D4E89><&spreadsheet></color> segmentationLabel : varchar(50)
  <color:#1D4E89><&spreadsheet></color> isBlacklisted : boolean
}

entity "Address" as Address {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> recipientName : varchar(150)
  <color:#1D4E89><&spreadsheet></color> phoneNumber : varchar(20)
  <color:#1D4E89><&spreadsheet></color> province : varchar(100)
  <color:#1D4E89><&spreadsheet></color> districtWard : varchar(100)
  <color:#1D4E89><&spreadsheet></color> detailAddress : varchar(255)
  <color:#1D4E89><&spreadsheet></color> isDefault : boolean
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#1D4E89><&spreadsheet></color> updatedAt : datetime
  <color:#2E7D32><&key></color> <i>Customerid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Provincecode</i> : <i>integer(10)</i>
  <color:#2E7D32><&key></color> <i>Wardcode</i> : <i>integer(10)</i>
}

entity "Province" as Province {
  <color:#B8860B><&key></color> <b>code</b> : <b>integer(10)</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> name : varchar(100)
}

entity "Ward" as Ward {
  <color:#B8860B><&key></color> <b>code</b> : <b>integer(10)</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> name : varchar(100)
  <color:#2E7D32><&key></color> <i>Provincecode</i> : <i>integer(10)</i>
}

Member ||-right-o| Staff
Member ||-down-o| Customer
Customer ||.down.o{ Address
Address }o.down.|| Province
Province ||.right.o{ Ward
Address }o..|| Ward

' ==============================================================
' CỘT 2: KHUYẾN MÃI, VOUCHER & ĐIỂM THƯỞNG (PROMOTION DOMAIN)
' ==============================================================
entity "Campaign" as Campaign {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> name : varchar(255)
  <color:#1D4E89><&spreadsheet></color> totalBudget : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> remainingBudget : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> startDate : datetime
  <color:#1D4E89><&spreadsheet></color> endDate : datetime
  <color:#1D4E89><&spreadsheet></color> bpmnProcessDefinitionKey : varchar(100)
  <color:#1D4E89><&spreadsheet></color> workflowJson : text
  <color:#1D4E89><&spreadsheet></color> bpmnXml : text
  <color:#1D4E89><&spreadsheet></color> triggerType : varchar(50)
  <color:#1D4E89><&spreadsheet></color> active : boolean
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#1D4E89><&spreadsheet></color> updatedAt : datetime
}

entity "IssuedVoucher" as IssuedVoucher {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> code : varchar(50)
  <color:#1D4E89><&spreadsheet></color> voucherType : varchar(30)
  <color:#1D4E89><&spreadsheet></color> status : varchar(30)
  <color:#1D4E89><&spreadsheet></color> discountPercent : decimal(5,2)
  <color:#1D4E89><&spreadsheet></color> maxDiscountAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> discountAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> minOrderValue : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> maxShippingDiscount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> restrictedCategoryIds : text
  <color:#1D4E89><&spreadsheet></color> restrictedProductIds : text
  <color:#1D4E89><&spreadsheet></color> expiresAt : datetime
  <color:#1D4E89><&spreadsheet></color> usedAt : datetime
  <color:#1D4E89><&spreadsheet></color> idempotencyKey : varchar(100)
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#2E7D32><&key></color> <i>Campaignid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Customerid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Orderid</i> : <i>bigint</i>
}

entity "LoyaltyPointTransaction" as LoyaltyPointTransaction {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> delta : integer(10)
  <color:#1D4E89><&spreadsheet></color> balanceAfter : integer(10)
  <color:#1D4E89><&spreadsheet></color> calculationMode : varchar(50)
  <color:#1D4E89><&spreadsheet></color> sourceType : varchar(50)
  <color:#1D4E89><&spreadsheet></color> referenceId : varchar(100)
  <color:#1D4E89><&spreadsheet></color> description : text
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#2E7D32><&key></color> <i>Customerid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Orderid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Campaignid</i> : <i>bigint</i>
}

Campaign |o.down.o{ IssuedVoucher
Campaign |o..o{ LoyaltyPointTransaction
Customer ||.right.o{ IssuedVoucher
Customer ||.right.o{ LoyaltyPointTransaction

' ==============================================================
' CỘT 3: ĐƠN HÀNG, THANH TOÁN & HOÀN TIỀN (ORDER & PAYMENT DOMAIN)
' ==============================================================
entity "Order" as Order {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> email : varchar(150)
  <color:#1D4E89><&spreadsheet></color> status : varchar(30)
  <color:#1D4E89><&spreadsheet></color> totalAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> discountAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> finalAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> totalWeight : decimal(10,2)
  <color:#1D4E89><&spreadsheet></color> couponCode : varchar(50)
  <color:#1D4E89><&spreadsheet></color> appliedCampaignId : varchar(50)
  <color:#1D4E89><&spreadsheet></color> pointsRedeemed : integer(10)
  <color:#1D4E89><&spreadsheet></color> pointDiscountAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> shippingFee : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> shippingDiscountAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> vatAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> trackingCode : varchar(100)
  <color:#1D4E89><&spreadsheet></color> shippingAddress : text
  <color:#1D4E89><&spreadsheet></color> phoneNumber : varchar(20)
  <color:#1D4E89><&spreadsheet></color> note : text
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#1D4E89><&spreadsheet></color> updatedAt : datetime
  <color:#2E7D32><&key></color> <i>Customerid</i> : <i>bigint</i>
}

entity "Payment" as Payment {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> email : varchar(150)
  <color:#1D4E89><&spreadsheet></color> txnRef : varchar(100)
  <color:#1D4E89><&spreadsheet></color> gatewayTxnId : varchar(100)
  <color:#1D4E89><&spreadsheet></color> paymentMethod : varchar(50)
  <color:#1D4E89><&spreadsheet></color> amount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> currency : varchar(10)
  <color:#1D4E89><&spreadsheet></color> status : varchar(20)
  <color:#1D4E89><&spreadsheet></color> failureCode : varchar(50)
  <color:#1D4E89><&spreadsheet></color> gatewayResponse : text
  <color:#1D4E89><&spreadsheet></color> paidAt : datetime
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#1D4E89><&spreadsheet></color> updatedAt : datetime
  <color:#2E7D32><&key></color> <i>Orderid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Customerid</i> : <i>bigint</i>
}

entity "Refund" as Refund {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> refundAmount : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> reason : text
  <color:#1D4E89><&spreadsheet></color> status : varchar(20)
  <color:#1D4E89><&spreadsheet></color> gatewayRefundId : varchar(100)
  <color:#1D4E89><&spreadsheet></color> requestedBy : varchar(100)
  <color:#1D4E89><&spreadsheet></color> completedAt : datetime
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#2E7D32><&key></color> <i>Paymentid</i> : <i>bigint</i>
}

IssuedVoucher }o.right.o| Order
Customer ||.right.o{ Order
Order |o..o{ LoyaltyPointTransaction
Order ||.down.o{ Payment
Customer |o..o{ Payment
Payment ||.right.o{ Refund

' ==============================================================
' CỘT 4: THƯƠNG HIỆU, DANH MỤC, THUỘC TÍNH & MẶT HÀNG (CATALOG DOMAIN)
' ==============================================================
entity "Brand" as Brand {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> name : varchar(150)
  <color:#1D4E89><&spreadsheet></color> slug : varchar(150)
  <color:#1D4E89><&spreadsheet></color> logoUrl : varchar(500)
  <color:#1D4E89><&spreadsheet></color> description : text
  <color:#1D4E89><&spreadsheet></color> active : boolean
}

entity "BrandCategory" as BrandCategory {
  <color:#2E7D32><&key></color> <b><i>Brandid</i></b> : <b><i>bigint</i></b>
  <color:#2E7D32><&key></color> <b><i>Categoryid</i></b> : <b><i>bigint</i></b>
  --
}

entity "Category" as Category {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> name : varchar(200)
  <color:#1D4E89><&spreadsheet></color> slug : varchar(200)
  <color:#1D4E89><&spreadsheet></color> parentId : bigint
  <color:#1D4E89><&spreadsheet></color> imageUrl : varchar(500)
  <color:#1D4E89><&spreadsheet></color> icon : varchar(100)
  <color:#1D4E89><&spreadsheet></color> sortOrder : integer(10)
  <color:#1D4E89><&spreadsheet></color> active : boolean
}

entity "CategoryAttribute" as CategoryAttribute {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> isVariant : boolean
  <color:#1D4E89><&spreadsheet></color> isRequired : boolean
  <color:#1D4E89><&spreadsheet></color> isFilter : boolean
  <color:#2E7D32><&key></color> <i>Categoryid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Attributeid</i> : <i>bigint</i>
}

entity "Attribute" as Attribute {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> code : varchar(50)
  <color:#1D4E89><&spreadsheet></color> name : varchar(100)
  <color:#1D4E89><&spreadsheet></color> valueType : varchar(50)
  <color:#1D4E89><&spreadsheet></color> allowedValues : text
  <color:#1D4E89><&spreadsheet></color> isColor : boolean
}

entity "OrderItem" as OrderItem {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> productName : varchar(255)
  <color:#1D4E89><&spreadsheet></color> productImage : varchar(500)
  <color:#1D4E89><&spreadsheet></color> variantAttr : text
  <color:#1D4E89><&spreadsheet></color> unitPrice : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> quantity : integer(10)
  <color:#1D4E89><&spreadsheet></color> subtotal : decimal(15,2)
  <color:#2E7D32><&key></color> <i>Orderid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Productid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>ProductVariantid</i> : <i>bigint</i>
}

Brand ||-down-o{ BrandCategory
BrandCategory }o-down-|| Category
Category ||.down.o{ CategoryAttribute
Attribute ||.right.o{ CategoryAttribute
CategoryAttribute -[hidden]down- OrderItem
Order ||.right.o{ OrderItem

' ==============================================================
' CỘT 5: SẢN PHẨM & BIẾN THỂ (PRODUCT & VARIANT DOMAIN)
' ==============================================================
entity "Product" as Product {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> name : varchar(255)
  <color:#1D4E89><&spreadsheet></color> slug : varchar(255)
  <color:#1D4E89><&spreadsheet></color> description : text
  <color:#1D4E89><&spreadsheet></color> attributes : text
  <color:#1D4E89><&spreadsheet></color> specsRaw : text
  <color:#1D4E89><&spreadsheet></color> price : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> costPrice : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> salePrice : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> weight : decimal(10,2)
  <color:#1D4E89><&spreadsheet></color> length : decimal(10,2)
  <color:#1D4E89><&spreadsheet></color> width : decimal(10,2)
  <color:#1D4E89><&spreadsheet></color> height : decimal(10,2)
  <color:#1D4E89><&spreadsheet></color> brand : varchar(100)
  <color:#1D4E89><&spreadsheet></color> imageUrl : varchar(500)
  <color:#1D4E89><&spreadsheet></color> warrantyPeriod : integer(10)
  <color:#1D4E89><&spreadsheet></color> warrantyPolicy : text
  <color:#1D4E89><&spreadsheet></color> salesCount : integer(10)
  <color:#1D4E89><&spreadsheet></color> ratingAvg : decimal(3,2)
  <color:#1D4E89><&spreadsheet></color> active : boolean
  <color:#1D4E89><&spreadsheet></color> createdAt : datetime
  <color:#1D4E89><&spreadsheet></color> updatedAt : datetime
  <color:#2E7D32><&key></color> <i>Categoryid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Brandid</i> : <i>bigint</i>
}

entity "ProductImage" as ProductImage {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> imageUrl : varchar(500)
  <color:#1D4E89><&spreadsheet></color> sortOrder : integer(10)
  <color:#1D4E89><&spreadsheet></color> isPrimary : boolean
  <color:#2E7D32><&key></color> <i>Productid</i> : <i>bigint</i>
}

entity "ProductTag" as ProductTag {
  <color:#2E7D32><&key></color> <b><i>Productid</i></b> : <b><i>bigint</i></b>
  <color:#B8860B><&key></color> <b>tag</b> : <b>varchar(100)</b>
  --
}

entity "ProductAttributeValue" as ProductAttributeValue {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> value : varchar(255)
  <color:#2E7D32><&key></color> <i>Productid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Attributeid</i> : <i>bigint</i>
}

entity "ProductVariant" as ProductVariant {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> sku : varchar(100)
  <color:#1D4E89><&spreadsheet></color> variantAttr : text
  <color:#1D4E89><&spreadsheet></color> price : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> costPrice : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> salePrice : decimal(15,2)
  <color:#1D4E89><&spreadsheet></color> weight : decimal(10,2)
  <color:#1D4E89><&spreadsheet></color> imageUrl : varchar(500)
  <color:#1D4E89><&spreadsheet></color> active : boolean
  <color:#2E7D32><&key></color> <i>Productid</i> : <i>bigint</i>
}

entity "VariantOptionValue" as VariantOptionValue {
  <color:#B8860B><&key></color> <b>id</b> : <b>bigint</b> <color:#900000><b>[U]</b></color>
  --
  <color:#1D4E89><&spreadsheet></color> value : varchar(255)
  <color:#2E7D32><&key></color> <i>ProductVariantid</i> : <i>bigint</i>
  <color:#2E7D32><&key></color> <i>Attributeid</i> : <i>bigint</i>
}

Brand |o.right.o{ Product
Category ||.right.o{ Product

Product ||.down.o{ ProductImage
Product ||-down-o{ ProductTag
Product ||.down.o{ ProductAttributeValue
ProductImage -[hidden]right- ProductTag
ProductTag -[hidden]right- ProductAttributeValue
Attribute ||.right.o{ ProductAttributeValue

Product ||.down.o{ ProductVariant
Product ||.left.o{ OrderItem
OrderItem }o.right.o| ProductVariant
ProductVariant ||.down.o{ VariantOptionValue
Attribute ||.right.o{ VariantOptionValue

' ==============================================================
' CỘT 6: ĐÁNH GIÁ, YÊU THÍCH & KHO HÀNG (REVIEW & INVENTORY DOMAIN)

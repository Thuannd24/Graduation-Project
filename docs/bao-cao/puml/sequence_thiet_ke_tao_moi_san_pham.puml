@startuml sequence_thiet_ke_tao_moi_san_pham
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

<style>
sequenceDiagram {
  LineColor #000000
  LineThickness 1.2
  arrow {
    LineColor #000000
    LineThickness 1.2
    FontColor #000000
    FontSize 8
  }
  lifeLine {
    LineColor #000000
    LineThickness 1.0
    BackgroundColor #7ACFF5
  }
  participant {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 8.5
    FontStyle bold
  }
  actor {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 8.5
    FontStyle bold
  }
  boundary {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 8.5
    FontStyle bold
  }
  control {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 8.5
    FontStyle bold
  }
  entity {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 8.5
    FontStyle bold
  }
}
</style>

skinparam {
  vpDiagramType SequenceDiagram
  defaultFontSize 8
  defaultFontColor #000000
  shadowing false
  roundcorner 0
  
  sequenceLifeLineBorderColor #000000
  sequenceLifeLineBackgroundColor #7ACFF5
  
  sequenceParticipantBorderColor #000000
  sequenceParticipantBackgroundColor #7ACFF5
  sequenceParticipantFontSize 8.5
  sequenceParticipantFontStyle bold
  
  sequenceActorBorderColor #000000
  sequenceActorBackgroundColor #7ACFF5
  sequenceActorFontSize 8.5
  sequenceActorFontStyle bold
  
  sequenceArrowColor #000000
  sequenceArrowThickness 1.2
  sequenceArrowFontSize 8
  sequenceArrowFontColor #000000
}

actor "Manager Staff" as staff
boundary "MainStaffView" as mainView
boundary "ManageProductView" as manageView
boundary "AddProductView" as addView
control "AdminProductController" as controller
control "ProductServiceImpl" as service
control "ProductRepository" as productRepo
control "ProductVariantRepository" as variantRepo
entity "Product" as product
entity "ProductVariant" as variant

' ==============================================================================
' GIAI ĐOẠN 1: ĐIỀU HƯỚNG TỪ MÀN HÌNH CHÍNH SANG QUẢN LÝ SẢN PHẨM (BƯỚC 1-4)
' ==============================================================================
staff -> mainView : 1: click navProducts
activate staff
activate mainView
mainView -> mainView : 2: navigateToProducts()
activate mainView
deactivate mainView
mainView -> manageView : 3: call
activate manageView
deactivate mainView
manageView --> staff : 4: display tblProducts

' ==============================================================================
' GIAI ĐOẠN 2: MỞ FORM TẠO MỚI SẢN PHẨM (BƯỚC 5-8)
' ==============================================================================
staff -> manageView : 5: click btnAddProduct
manageView -> manageView : 6: onOpenAddProduct()
activate manageView
deactivate manageView
manageView -> addView : 7: call
activate addView
deactivate manageView
addView --> staff : 8: display add product form

' ==============================================================================
' GIAI ĐOẠN 3: NHẬP THÔNG TIN, CHỌN DANH MỤC & TẢI ẢNH LÊN STORAGE (BƯỚC 9-17)
' ==============================================================================
staff -> addView : 9: input txtName & txtSlug
addView -> addView : 10: handleNameChange(e)
activate addView
deactivate addView

staff -> addView : 11: select selCategory
addView -> addView : 12: handleCategoryChange(catId)
activate addView
deactivate addView

staff -> addView : 13: select fileImages & upload
addView -> addView : 14: handleFileUpload(files)
activate addView
deactivate addView
addView -> controller : 15: uploadProductImage(file, folder)
activate controller
controller --> addView : 16: return ApiResponse(imageUrl)
deactivate controller
addView --> staff : 17: display image preview

' ==============================================================================
' GIAI ĐOẠN 4: CẤU HÌNH BIẾN THỂ & SINH LƯỚI BIẾN THỂ (BƯỚC 18-20)
' ==============================================================================
staff -> addView : 18: configure options & generate variants
addView -> addView : 19: generateVariantsGrid()
activate addView
deactivate addView
addView --> staff : 20: display listVariants

' ==============================================================================
' GIAI ĐOẠN 5: GỬI FORM & LƯU SẢN PHẨM, BIẾN THỂ VÀ THUỘC TÍNH (BƯỚC 21-44)
' ==============================================================================
staff -> addView : 21: click btnSubmit
addView -> addView : 22: handleSubmit(e)
activate addView
deactivate addView
addView -> controller : 23: createProduct(dto)
activate controller

controller -> service : 24: createProduct(dto)
activate service

service -> productRepo : 25: findBySlug(slug)
activate productRepo
productRepo --> service : 26: return Optional.empty()
deactivate productRepo

service -> service : 27: normalizeProductPricing(dto)
activate service
deactivate service

service -> service : 28: serializeSpecsRaw(specsRaw)
activate service
deactivate service

service -> product : 29: Product(dto)
activate product
product -> product : 30: Product()
activate product
deactivate product
product --> service : 31: return product
deactivate product

service -> productRepo : 32: save(product)
activate productRepo
productRepo --> service : 33: return savedProduct
deactivate productRepo

service -> service : 34: saveSpecifications(productId, attrs, attrMap)
activate service
deactivate service

service -> variant : 35: ProductVariant(variantDto)
activate variant
variant -> variant : 36: ProductVariant()
activate variant
deactivate variant
variant --> service : 37: return variant
deactivate variant

service -> variantRepo : 38: save(variant)
activate variantRepo
variantRepo --> service : 39: return savedVariant
deactivate variantRepo

service -> service : 40: saveVariantOptions(variantId, attrs, attrMap)
activate service
deactivate service

service -> service : 41: convertToDto(product)
activate service
deactivate service

service --> controller : 42: return productDto
deactivate service

controller --> addView : 43: return ApiResponse<ProductDto>
deactivate controller

addView --> staff : 44: sucess
deactivate addView
deactivate staff

right footer Powered By Visual Paradigm Community Edition
@enduml
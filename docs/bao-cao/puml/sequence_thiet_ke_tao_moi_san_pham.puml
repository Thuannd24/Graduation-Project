@startuml sequence_thiet_ke_tao_moi_san_pham
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

<style>
sequenceDiagram {
  LineColor #000000
  LineThickness 1.2
  arrow {
    LineColor #000000
    LineThickness 1.2
    FontColor #000000
    FontSize 11
    FontStyle bold
    HorizontalAlignment center
  }
  lifeLine {
    LineColor #000000
    LineThickness 1.0
    BackgroundColor #7ACFF5
  }
  participant {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 11
    FontStyle bold
  }
  actor {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 11
    FontStyle bold
  }
  boundary {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 11
    FontStyle bold
  }
  control {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 11
    FontStyle bold
  }
  entity {
    LineColor #000000
    LineThickness 1.2
    BackgroundColor #7ACFF5
    FontColor #000000
    FontSize 11
    FontStyle bold
  }
}
</style>

skinparam {
  vpDiagramType SequenceDiagram
  defaultFontSize 11
  defaultFontColor #000000
  defaultFontStyle bold
  shadowing false
  roundcorner 0
  
  ParticipantMinSize 0
  ParticipantPadding 10
  BoxPadding 2
  sequenceMessageAlign center
  
  sequenceLifeLineBorderColor #000000
  sequenceLifeLineBackgroundColor #7ACFF5
  
  sequenceParticipantBorderColor #000000
  sequenceParticipantBackgroundColor #7ACFF5
  sequenceParticipantFontSize 11
  sequenceParticipantFontStyle bold
  
  sequenceActorBorderColor #000000
  sequenceActorBackgroundColor #7ACFF5
  sequenceActorFontSize 11
  sequenceActorFontStyle bold
  
  sequenceArrowColor #000000
  sequenceArrowThickness 1.2
  sequenceArrowFontSize 11
  sequenceArrowFontColor #000000
  sequenceArrowFontStyle bold
}

title Sơ đồ tuần tự tạo mới sản phẩm

actor "Staff" as staff
boundary "MainStaff\nView" as mainView
boundary "ManageProduct\nView" as manageView
boundary "AddProduct\nView" as addView
control "AdminProduct\nController" as controller
control "ProductService\nImpl" as service
control "Category\nRepository" as categoryRepo
control "Brand\nRepository" as brandRepo
control "Attribute\nRepository" as attributeRepo
control "Product\nRepository" as productRepo
control "ProductVariant\nRepository" as variantRepo
entity "Product" as product
entity "Product\nImage" as prodImg
entity "ProductAttribute\nValue" as attrVal
entity "Product\nVariant" as variant
entity "VariantOption\nValue" as optVal

' ==============================================================================
' GIAI ĐOẠN 1: ĐIỀU HƯỚNG TỪ MÀN HÌNH CHÍNH SANG QUẢN LÝ SẢN PHẨM (BƯỚC 1-4)
' ==============================================================================
staff -> mainView : 1: click navProducts
activate staff
activate mainView
mainView -> mainView : 2: navigateToProducts()
activate mainView
deactivate mainView
mainView -> manageView : 3: call
activate manageView
deactivate mainView
manageView --> staff : 4: display tblProducts

' ==============================================================================
' GIAI ĐOẠN 2: MỞ FORM TẠO MỚI SẢN PHẨM & TẢI DANH MỤC KHỞI TẠO (BƯỚC 5-14)
' ==============================================================================
staff -> manageView : 5: click btnAddProduct
manageView -> manageView : 6: onOpenAddProduct()
activate manageView
deactivate manageView
manageView -> addView : 7: call
activate addView
deactivate manageView

addView -> controller : 8: getInitialData()
activate controller
controller -> service : 9: getInitialData()
activate service
service -> categoryRepo : 10: findAll()
activate categoryRepo
categoryRepo --> service : 11: return
deactivate categoryRepo
service --> controller : 12: return
deactivate service
controller --> addView : 13: return
deactivate controller
addView --> staff : 14: display add form

' ==============================================================================
' GIAI ĐOẠN 3: CHỌN DANH MỤC & TẢI THƯƠNG HIỆU, THUỘC TÍNH ĐỘNG (BƯỚC 15-24)
' ==============================================================================
staff -> addView : 15: select selCategory
addView -> addView : 16: handleCategoryChange(catId)
activate addView
deactivate addView
addView -> controller : 17: getCategoryMetadata(catId)
activate controller
controller -> service : 18: getCategoryMetadata(catId)
activate service
service -> brandRepo : 19: findActiveBrands(catId)
activate brandRepo
brandRepo --> service : 20: return
deactivate brandRepo
service -> attributeRepo : 21: findAll()
activate attributeRepo
attributeRepo --> service : 22: return
deactivate attributeRepo
service --> controller : 23: return
deactivate service
controller --> addView : 24: return
deactivate controller

' ==============================================================================
' GIAI ĐOẠN 4: NHẬP THÔNG TIN, KIỂM TRA SLUG & TẢI ẢNH LÊN STORAGE (BƯỚC 25-34)
' ==============================================================================
staff -> addView : 25: input txtName & txtSlug
addView -> addView : 26: handleNameChange(e)
activate addView
deactivate addView

staff -> addView : 27: select fileImages & upload
addView -> addView : 28: handleFileUpload(files)
activate addView
deactivate addView
addView -> controller : 29: uploadProductImage(file, folder)
activate controller
controller --> addView : 30: return
deactivate controller
addView --> staff : 31: display preview

staff -> addView : 32: configure variants
addView -> addView : 33: generateVariantsGrid()
activate addView
deactivate addView
addView --> staff : 34: display variants

' ==============================================================================
' GIAI ĐOẠN 5: GỬI FORM & LƯU TOÀN DIỆN DỮ LIỆU QUA CÁC LỚP THỰC THỂ (BƯỚC 35-64)
' ==============================================================================
staff -> addView : 35: click btnSubmit
addView -> addView : 36: handleSubmit(e)
activate addView
deactivate addView
addView -> controller : 37: createProduct(dto)
activate controller

controller -> service : 38: createProduct(dto)
activate service

service -> productRepo : 39: findBySlug(slug)
activate productRepo
productRepo --> service : 40: return
deactivate productRepo

service -> service : 41: normalizeProductPricing(dto)
activate service
deactivate service

service -> service : 42: serializeSpecsRaw(specsRaw)
activate service
deactivate service

service -> product : 43: Product(dto)
activate product
product -> product : 44: Product()
activate product
deactivate product
product --> service : 45: return
deactivate product

service -> productRepo : 46: save(product)
activate productRepo
productRepo --> service : 47: return
deactivate productRepo

service -> prodImg : 48: ProductImage(dto)
activate prodImg
prodImg --> service : 49: return
deactivate prodImg

service -> service : 50: saveSpecifications(attrs)
activate service
deactivate service

service -> attrVal : 51: ProductAttributeValue(dto)
activate attrVal
attrVal --> service : 52: return
deactivate attrVal

service -> variant : 53: ProductVariant(variantDto)
activate variant
variant -> variant : 54: ProductVariant()
activate variant
deactivate variant
variant --> service : 55: return
deactivate variant

service -> variantRepo : 56: save(variant)
activate variantRepo
variantRepo --> service : 57: return
deactivate variantRepo

service -> service : 58: saveVariantOptions(attrs)
activate service
deactivate service

service -> optVal : 59: VariantOptionValue(dto)
activate optVal
optVal --> service : 60: return
deactivate optVal

service -> service : 61: convertToDto(product)
activate service
deactivate service

service --> controller : 62: return
deactivate service

controller --> addView : 63: return
deactivate controller

addView --> staff : 64: sucess
deactivate addView
deactivate staff

right footer Powered By Visual Paradigm Community Edition
@enduml

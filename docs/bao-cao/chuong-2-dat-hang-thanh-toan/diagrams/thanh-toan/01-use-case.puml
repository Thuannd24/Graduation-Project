@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #4B5563
skinparam ArrowThickness 1
skinparam defaultTextAlignment center
skinparam actorBorderColor #4B5563
skinparam actorBackgroundColor #7DCFF0
!pragma layout smetana
left to right direction
skinparam rectangleBackgroundColor #7DCFF0
skinparam rectangleBorderColor #4B5563
skinparam usecaseBackgroundColor #7DCFF0
skinparam usecaseBorderColor #4B5563
skinparam usecaseFontSize 14

actor "Khách hàng" as Customer
actor "Cổng VNPay" as VNPay
rectangle "AuraTech — Thanh toán đơn hàng qua VNPay" {
  usecase "Thanh toán đơn hàng\nqua VNPay" as Pay
  usecase "Kiểm tra điều kiện\nthanh toán" as Validate
  usecase "Khởi tạo lượt\nthanh toán" as Initiate
  usecase "Xác minh và ghi nhận\nkết quả giao dịch" as Verify
  usecase "Xem kết quả\nthanh toán" as Result
}
Customer -- Pay
Customer -- Result
Pay ..> Validate : <<include>>
Pay ..> Initiate : <<include>>
Pay ..> Verify : <<include>>
Pay -- VNPay
Verify -- VNPay
@enduml

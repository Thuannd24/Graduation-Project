@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #4B5563
skinparam ArrowThickness 1
skinparam defaultTextAlignment center
skinparam actorBorderColor #4B5563
skinparam actorBackgroundColor #7DCFF0
!pragma layout smetana
skinparam stateBackgroundColor #7DCFF0
skinparam stateBorderColor #4B5563
skinparam stateStartColor black
skinparam stateEndColor black
hide empty description

state "Chờ kết quả\nPENDING" as Pending
state "Đã thanh toán\nSUCCESS" as Success
state "Thất bại\nFAILED" as Failed
state "Hết hạn lượt\nEXPIRED" as Expired
state "Chờ hoàn tiền\nREFUND_PENDING" as Refunding

[*] --> Pending : Khởi tạo lượt
Pending --> Success : Callback / đối soát\nxác nhận thành công
Pending --> Failed : Giao dịch thất bại\nhoặc đơn bị hủy
Pending --> Expired : Quá hạn lượt;\nđối soát xác nhận chưa trả
Failed --> Pending : Thử lại\n[đơn hợp lệ]
Expired --> Pending : Thử lại\n[đơn hợp lệ]
Pending --> Pending : Thay lượt\n[được phép]
Failed --> Refunding : Nhận tiền muộn\n[lượt hiện tại]
Expired --> Refunding : Nhận tiền muộn\n[lượt hiện tại]
Success --> Refunding : Hủy / hoàn hàng\n[còn tiền cần hoàn]
@enduml

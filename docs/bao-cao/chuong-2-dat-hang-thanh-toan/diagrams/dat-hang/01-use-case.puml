@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #4B5563
skinparam ArrowThickness 1
skinparam defaultTextAlignment center
skinparam actorBorderColor #4B5563
skinparam actorBackgroundColor #7DCFF0
!pragma layout smetana
left to right direction
skinparam rectangleBackgroundColor #7DCFF0
skinparam rectangleBorderColor #4B5563
skinparam usecaseBackgroundColor #7DCFF0
skinparam usecaseBorderColor #4B5563
skinparam usecaseFontSize 14

actor "Khách hàng" as Customer
rectangle "AuraTech — Đặt hàng trực tuyến" {
  usecase "Đặt hàng trực tuyến" as Order
  usecase "Xem trước đơn hàng" as Preview
  usecase "Cung cấp thông tin\ngiao nhận" as Shipping
  usecase "Kiểm tra khả năng\nđáp ứng đơn hàng" as Availability
  usecase "Áp dụng mã giảm giá" as Voucher
  usecase "Sử dụng điểm thưởng" as Points
}
Customer -- Order
Order ..> Preview : <<include>>
Order ..> Shipping : <<include>>
Order ..> Availability : <<include>>
Voucher ..> Preview : <<extend>>\n[khách chọn mã]
Points ..> Preview : <<extend>>\n[khách chọn điểm]
@enduml

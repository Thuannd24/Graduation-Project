      CONNECT_VALUE_CONVERTER_SCHEMAS_ENABLE: "false"
    networks:
      - ecommerce-network
    restart: always
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8083/"]
      interval: 10s
      timeout: 10s
      retries: 15
      start_period: 180s

  debezium-init:
    image: curlimages/curl:8.5.0
    container_name: local-debezium-init
    depends_on:
      debezium-connect:
        condition: service_healthy
    networks:
      - ecommerce-network
    environment:
      - DB_PASSWORD=${DB_PASSWORD:-root}

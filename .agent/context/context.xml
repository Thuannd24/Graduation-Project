        else Gửi thất bại (SMTP lỗi)
            SMTP-->>NC: Lỗi kết nối
            NC->>DB: INSERT notifications { status: FAILED, retryCount: 1 }
            Note over NC: Kafka giữ offset → Tự động retry sau
        end
    end

    SMTP->>User: Gửi email

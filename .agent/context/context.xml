    rect rgb(245, 245, 245)
        Note over NC, SMTP: Bước 3: Gửi Email
        NC->>SMTP: send({ to: email, subject: "Đơn hàng #100 đã được đặt!", html: htmlContent })
        alt Gửi thành công
            SMTP-->>NC: 200 OK
            NC->>DB: INSERT notifications { status: SENT, sentAt: now() }
